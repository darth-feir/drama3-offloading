# Copy to bin/env.local and edit. Sourced by bin/env.sh before every
# default, so anything set here wins. Gitignored.
#
# You need these only when the checkout does NOT sit beside its venv,
# fish-speech clone and weights. A fresh install from bin/setup.sh needs
# none of them.

# export DRAMA3_VENV=/path/to/venv
# export DRAMA3_FISH=/path/to/fish-speech
# export HF_HOME=/path/with/40GB

# A reference clip is optional once you have registered a voice with
# --addvoice; it is the unnamed fallback.
# export DRAMA3_REF="/path/to/clip.mp3"

# Speech-to-text for the content check. DRAMA3_STT_START is run by
# `--start` if that endpoint is not already answering.
# export DRAMA3_STT=http://127.0.0.1:8816
# export DRAMA3_STT_START="/path/to/stt-venv/bin/parakeet-api serve"

# Browser clients. Off by default; never applied to /admin/*.
# export DRAMA3_CORS=http://localhost:3000
