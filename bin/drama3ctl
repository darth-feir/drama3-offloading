#!/usr/bin/env bash
# Start and stop the resident Drama 3 server, so `say` has somewhere to POST.
#
#   bin/drama3ctl start [-- extra server.py args]
#   bin/drama3ctl stop | status | log | restart
#
# Configure it by exporting these before `start`, or by editing run/config:
#
#   DRAMA3_REF        reference clip (required)
#   DRAMA3_REF_TEXT   its transcript. Recommended, but less critical than
#                     this once claimed: a wrong transcript measured no
#                     worse on timbre or content, only ~8 % slower. See
#                     notes/17.
#   DRAMA3_PORT       default 8123
#   DRAMA3_STT        OpenAI-compatible transcription endpoint
#   DRAMA3_STT_START  OPTIONAL fallback command that starts a local STT
#                     server if DRAMA3_STT is not answering. Unused when
#                     something else (e.g. a systemd unit) already serves
#                     that endpoint -- in which case STT logs go to ITS
#                     log, not run/stt.log. See start_stt_if_needed.
#                     ⚠️ The server transcribes the reference clip at
#                     startup when DRAMA3_REF_TEXT is unset, so a dead
#                     STT is a FAILED boot, not a degraded one -- that
#                     happened once, 20 s before STT came up. Only ever
#                     stopped again if WE started it.
#
# ⚠️ Liveness is tracked with a PID FILE, never by matching command-line
# text. `pgrep -f "[p]ip install"` hung a wait loop indefinitely during this
# project because an unrelated session's process carried that string: the
# bracket trick stops a pattern matching YOUR OWN process, not somebody
# else's. A pid is unambiguous; a command line is a guess.
set -uo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO"

# ⚠️ Source the environment HERE, not only in bin/run.sh. run.sh sources
# env.sh for the CHILD; this script's own shell saw none of it, so
# anything written in bin/env.local -- DRAMA3_STT, DRAMA3_STT_START,
# DRAMA3_RUN, DRAMA3_VOICES -- was invisible to the launcher.
#
# The visible symptom was silence: with DRAMA3_STT unset, stt_ok() says
# "nothing configured, that is fine" and the autostart block returns
# early, so STT was never started AND no warning was printed. The user
# found the content check quietly off.
# shellcheck disable=SC1091
[ -f "$REPO/bin/env.sh" ] && source "$REPO/bin/env.sh" >/dev/null 2>&1

RUN="${DRAMA3_RUN:-$REPO/run}"
PIDFILE="$RUN/server.pid"
STT_PIDFILE="$RUN/stt.pid"
LOGFILE="$RUN/server.log"
# ⚠️ Deliberately EMPTY when unset, not defaulted to 8123/127.0.0.1.
# These are only passed to the server if the user actually set them; the
# config file is what decides otherwise. Defaulting here and passing the
# default as a flag is what used to override `[server] port` in
# config.toml without saying so.
PORT="${DRAMA3_PORT:-}"
HOST="${DRAMA3_HOST:-}"

# Where the running server says it bound. Falls back to the documented
# default only when there is nothing to read -- that is a guess, and it is
# used only to print a hint before the server exists.
URLFILE="$RUN/server.url"
base_url() {
    if [ -s "$URLFILE" ]; then
        tr -d "[:space:]" < "$URLFILE"
    else
        echo "http://${HOST:-127.0.0.1}:${PORT:-8123}"
    fi
}
mkdir -p "$RUN"

alive() {  # alive <pid>
    [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

current_pid() {
    [ -r "$PIDFILE" ] || return 1
    local pid; pid="$(cat "$PIDFILE" 2>/dev/null)"
    alive "$pid" || return 1
    echo "$pid"
}

health() {
    curl -fsS --max-time 3 "$(base_url)/health" 2>/dev/null
}

stt_ok() {
    # No endpoint configured is "fine" here: the content check is optional
    # and the server says so itself.
    [ -n "${DRAMA3_STT:-}" ] || return 0
    case "$DRAMA3_STT" in
        http*) curl -fsS --max-time 3 "${DRAMA3_STT%/}/health" >/dev/null 2>&1 ;;
        *)     [ -S "$DRAMA3_STT" ] || [ -e "$DRAMA3_STT" ] ;;
    esac
}

start_stt_if_needed() {
    # ⚠️ If something else already owns STT -- a systemd unit, say -- this
    # returns here and run/stt.log is NEVER written. That is correct, and
    # it is also a trap: a stale or absent stt.log then looks like
    # "STT never ran" when STT is in fact healthy and logging elsewhere.
    #
    #   systemd user unit  ->  journalctl --user -u parakeet-stt -f
    #   started by us      ->  run/stt.log  (only then)
    #
    # Check the ENDPOINT to know whether STT is alive, never the file.
    stt_ok && return 0
    if [ -z "${DRAMA3_STT_START:-}" ]; then
        echo "note: DRAMA3_STT=$DRAMA3_STT is not answering and" >&2
        echo "      DRAMA3_STT_START is unset, so it will not be started." >&2
        echo "      Without STT the content check is off, and startup FAILS" >&2
        echo "      outright unless DRAMA3_REF_TEXT is set." >&2
        return 0
    fi
    echo "starting STT: $DRAMA3_STT_START"
    setsid bash -c "$DRAMA3_STT_START" >> "$RUN/stt.log" 2>&1 &
    echo $! > "$STT_PIDFILE"
    local waited=0
    while [ "$waited" -lt 90 ]; do
        stt_ok && { echo "STT ready after ${waited}s"; return 0; }
        alive "$(cat "$STT_PIDFILE" 2>/dev/null)" || {
            echo "STT died on startup. Last lines:" >&2
            tail -10 "$RUN/stt.log" >&2
            rm -f "$STT_PIDFILE"
            return 1
        }
        sleep 2; waited=$((waited + 2))
    done
    echo "STT still not answering after ${waited}s; continuing anyway" >&2
}

cmd_start() {
    local pid
    if pid="$(current_pid)"; then
        echo "already running (pid $pid) on $(base_url)"
        return 0
    fi
    # ⚠️ Do NOT re-validate the reference here. config.toml documents
    # `voice.ref` as the way to set it, and this used to demand
    # DRAMA3_REF anyway -- so following the documentation produced
    # "DRAMA3_REF is unset" and the only way to find out why was to read
    # this file. A launcher that disagrees with the config format it ships
    # is worse than one that does no checking at all.
    #
    # server.py resolves flag -> env -> config and refuses with a message
    # naming both, before it loads the model, so a bad setup still fails
    # in a second rather than in forty.
    local args=(--state-dir "$RUN")
    [ -n "$HOST" ] && args+=(--host "$HOST")
    [ -n "$PORT" ] && args+=(--port "$PORT")
    [ -n "${DRAMA3_REF:-}" ] && args+=(--ref "$DRAMA3_REF")
    [ -n "${DRAMA3_REF_TEXT:-}" ] && args+=(--ref-text "$DRAMA3_REF_TEXT")
    args+=("$@")

    # ⚠️ Rotate, do not truncate. Truncating on start destroyed the evidence
    # from an A/B run the moment the second arm started -- the retry detail
    # that the whole experiment existed to collect.
    start_stt_if_needed || return 1

    # A crash leaves server.url behind; clear it so base_url() cannot
    # report a port that died with the last process.
    rm -f "$URLFILE"
    [ -s "$LOGFILE" ] && mv "$LOGFILE" "$LOGFILE.$(date +%Y%m%d-%H%M%S)"
    : > "$LOGFILE"
    # setsid so it survives this shell; bin/run.sh handles the nix-shell and
    # the environment.
    setsid "$REPO/bin/run.sh" bin/server.py "${args[@]}" >> "$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    echo "starting (pid $(cat "$PIDFILE")) -- the model load takes ~35 s"

    # ⚠️ Wait on the HEALTH ENDPOINT, not on a sleep. Load time varies with
    # page cache and whether the experts are already warm; a fixed sleep is
    # either a lie or a delay.
    local waited=0
    while [ "$waited" -lt 180 ]; do
        if health >/dev/null 2>&1; then
            echo "ready: $(health)"
            echo
            cmd_hint
            return 0
        fi
        if ! alive "$(cat "$PIDFILE" 2>/dev/null)"; then
            echo "FAILED to start. Last lines:" >&2
            tail -15 "$LOGFILE" >&2
            rm -f "$PIDFILE"
            return 1
        fi
        sleep 2; waited=$((waited + 2))
    done
    echo "still not healthy after ${waited}s; check: bin/drama3ctl log" >&2
    return 1
}

stop_stt_if_ours() {
    # ⚠️ ONLY stop an STT we started. The pidfile is the entire proof of
    # ownership: this box runs a long-lived Parakeet server of its own,
    # and a launcher that killed "the STT on that port" would take down
    # something it never started and cannot bring back.
    [ -f "$STT_PIDFILE" ] || return 0
    local spid; spid="$(cat "$STT_PIDFILE" 2>/dev/null)"
    rm -f "$STT_PIDFILE"
    alive "$spid" || return 0
    echo "stopping STT (pid $spid, started by us)"
    kill -TERM -"$spid" 2>/dev/null || kill -TERM "$spid" 2>/dev/null
}

cmd_stop() {
    local pid
    # ⚠️ Clear the URL on EVERY stop path, including "was not running".
    # The server removes it on clean shutdown, but a SIGKILL or a crash
    # leaves it behind, and a stale URL reads as a live server.
    rm -f "$URLFILE"
    stop_stt_if_ours
    pid="$(current_pid)" || { echo "not running"; rm -f "$PIDFILE"; return 0; }
    # setsid made it a process group leader, so signal the group: bin/run.sh
    # execs through nix-shell, and killing only the pid can orphan python
    # holding 30 GiB of pinned memory and the GPU.
    kill -TERM -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    local waited=0
    while alive "$pid" && [ "$waited" -lt 30 ]; do sleep 1; waited=$((waited + 1)); done
    if alive "$pid"; then
        echo "did not stop in ${waited}s, sending KILL"
        kill -KILL -"$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
        sleep 1
    fi
    rm -f "$PIDFILE"
    echo "stopped"
}

cmd_status() {
    local pid
    if pid="$(current_pid)"; then
        echo "running  pid $pid  $(base_url)"
        local h; h="$(health)"
        [ -n "$h" ] && echo "health   $h" || echo "health   NOT RESPONDING (still loading?)"
    else
        echo "stopped"
        [ -f "$PIDFILE" ] && echo "  (stale pidfile removed)" && rm -f "$PIDFILE"
    fi
    # Labelled "whole GPU" because it is: this is every process on the
    # card, not ours. Right after `stop` it can still read ~22 GiB while
    # the driver reclaims, which looks exactly like a leak and is not.
    command -v nvidia-smi >/dev/null && \
        echo "vram     $(nvidia-smi --query-gpu=memory.used --format=csv,noheader) (whole GPU)"
    # Exit 3 for "not running", after systemctl is-active. Returning 0
    # either way made `drama3ctl status && ...` always fire, so this is
    # only useful to a human reading it.
    current_pid >/dev/null || return 3
    return 0
}

cmd_hint() {
    # Bare JSON on stdout so it pipes into whatever consumes a backend
    # entry; prose goes to stderr so it stays out of the pipe.
    #
    # kind "openai" rather than a hand-written body template: this server
    # answers POST /v1/audio/speech, which is the nearest thing TTS has to a
    # common protocol. A generic HTTP escape hatch would work too, but there
    # is no reason to make a client special-case us.
    #
    # format wav, not pcm: a wav header carries its own sample rate, so
    # there is nothing for a client to misconfigure. Headerless PCM at
    # 44.1 kHz played as 22.05 kHz is the classic way to get half-speed
    # audio and no error message.
    #
    # concurrency 1 is not a preference. One model on one GPU serialises
    # internally, so two requests in flight do not finish sooner -- they
    # interleave and both finish later. prefetch is the knob that hides
    # latency; concurrency is the one that destroys it.
    cat >&2 <<EOF
This server answers the OpenAI speech API at $(base_url)/v1/audio/speech
See API.md for the full interface. The JSON on stdout is a ready-made
backend entry for a client that accepts one.
EOF
    cat <<EOF
{
  "kind": "openai",
  "url": "$(base_url)",
  "model": "drama-3",
  "voice": "drama3",
  "format": "wav",
  "rate": 44100,
  "concurrency": 1,
  "prefetch": 3
}
EOF
}

cmd_voices() {
    "$REPO/bin/run.sh" - <<'PY'
import sys; sys.path.insert(0, "bin")
import voices
names = voices.names()
if not names:
    print("no voices yet.  add one:")
    print("  bin/drama3ctl --addvoice NAME /path/to/clip.mp3")
else:
    default = voices.get_default()
    for n in names:
        m = voices.meta(n)
        mark = "*" if n == default else " "
        print(f" {mark} {n:<16} {m['seconds']:>5.1f}s  "
              f"{m['bytes']/2**20:>4.0f} MiB  {m['source']}")
    print()
    print("* = default")
PY
}

cmd_addvoice() {
    local name="${1:-}" clip="${2:-}"; shift 2 2>/dev/null || true
    [ -n "$name" ] && [ -n "$clip" ] || {
        echo "usage: $(basename "$0") --addvoice NAME /path/to/clip.mp3" >&2
        return 2
    }
    # ⚠️ If the server is up, ask IT to build the voice. It already holds
    # the model; the work is ~3 s of prefill queued behind whatever it is
    # doing. This used to stop and restart the server (~70 s) purely
    # because the builder loaded a second copy of the model and two will
    # not fit on a 24 GiB card -- which was an artifact of how the builder
    # was written, not a real constraint.
    if current_pid >/dev/null; then
        local url; url="$(base_url)"
        local reftext=""
        # --ref-text "..." may appear among the passthrough args
        while [ $# -gt 0 ]; do
            case "$1" in
                --ref-text) reftext="${2:-}"; shift 2 ;;
                *) shift ;;
            esac
        done
        echo "server is up; building '$name' in place (no restart)..."
        "$REPO/bin/run.sh" - "$url" "$name" "$clip" "$reftext" <<'PY'
import json, sys, urllib.request
url, name, clip, reftext = sys.argv[1:5]
body = {"name": name, "clip": clip}
if reftext:
    body["ref_text"] = reftext
req = urllib.request.Request(url.rstrip("/") + "/admin/voices",
                             data=json.dumps(body).encode(),
                             headers={"Content-Type": "application/json"})
try:
    # No timeout: it queues behind any in-flight generation, which can
    # legitimately take tens of seconds on a long paragraph.
    with urllib.request.urlopen(req) as r:
        info = json.load(r)
    print(f"voice {info['name']!r}: {info['bytes']/2**20:.0f} MiB, "
          f"{info['rows']} rows, built in {info['elapsed']}s -- ready now")
except urllib.error.HTTPError as exc:
    print(exc.read().decode()[:400], file=sys.stderr)
    sys.exit(1)
PY
        return $?
    fi

    # Nothing running: load a model of our own and build offline.
    "$REPO/bin/run.sh" bin/addvoice.py "$name" "$clip" \
        --dev-cache --pin-experts --vram-reserve 2 "$@"
}

cmd_delvoice() {
    local name="${1:-}"
    [ -n "$name" ] || { echo "usage: $(basename "$0") --delvoice NAME" >&2; return 2; }
    # If the server is up, tell IT -- otherwise the files go but the
    # running process keeps serving a voice the user thinks is deleted.
    if current_pid >/dev/null; then
        "$REPO/bin/run.sh" - "$(base_url)" "$name" <<'PY'
import json, sys, urllib.request
url, name = sys.argv[1:3]
req = urllib.request.Request(url.rstrip("/") + "/admin/voices/remove",
                             data=json.dumps({"name": name}).encode(),
                             headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=30) as r:
        info = json.load(r)
    left = ", ".join(info["voices"]) or "(none)"
    print(f"removed {info['removed']!r}; remaining: {left}")
    if info.get("default"):
        print(f"default is now {info['default']!r}")
except urllib.error.HTTPError as exc:
    print(exc.read().decode()[:300], file=sys.stderr); sys.exit(1)
PY
        return $?
    fi
    "$REPO/bin/run.sh" - "$name" <<'PY'
import sys; sys.path.insert(0, "bin")
import voices
name = sys.argv[1]
if name not in voices.names():
    print(f"no voice named {name!r}; have: "
          f"{', '.join(voices.names()) or '(none)'}", file=sys.stderr)
    sys.exit(1)
voices.remove(name)
print(f"removed {name!r}; remaining: {', '.join(voices.names()) or '(none)'}")
PY
}

cmd_defaultvoice() {
    local name="${1:-}"
    [ -n "$name" ] || { echo "usage: $(basename "$0") --defaultvoice NAME" >&2; return 2; }
    # Tell the running server, not just the disk -- the same mistake
    # --delvoice would have made: files updated, process unaware.
    if current_pid >/dev/null; then
        "$REPO/bin/run.sh" - "$(base_url)" "$name" <<'PY'
import json, sys, urllib.request
url, name = sys.argv[1:3]
req = urllib.request.Request(url.rstrip("/") + "/admin/voices/default",
                             data=json.dumps({"name": name}).encode(),
                             headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=30) as r:
        print(f"default voice is now {json.load(r)['default']!r}")
except urllib.error.HTTPError as exc:
    print(exc.read().decode()[:300], file=sys.stderr); sys.exit(1)
PY
        return $?
    fi
    "$REPO/bin/run.sh" - "$name" <<'PY'
import sys; sys.path.insert(0, "bin")
import voices
voices.set_default(sys.argv[1])
print(f"default voice is now {sys.argv[1]!r}")
PY
}

case "${1:-}" in
    # Flag forms, because "--start" reads like a program and "start" reads
    # like a subcommand, and people reach for the first.
    --start)        shift; cmd_start "$@"; rc=$?
                    [ $rc -eq 0 ] && { echo; echo "following the log; Ctrl-C detaches, the server keeps running"; tail -f "$LOGFILE"; }
                    exit $rc ;;
    --stop)         cmd_stop ;;
    --restart)      cmd_stop; shift; cmd_start "$@" ;;
    --status)       cmd_status ;;
    --config)       cmd_hint ;;
    --voices)       cmd_voices ;;
    --addvoice)     shift; cmd_addvoice "$@" ;;
    --delvoice)     shift; cmd_delvoice "$@" ;;
    --defaultvoice) shift; cmd_defaultvoice "$@" ;;
    start)   shift; [ "${1:-}" = "--" ] && shift; cmd_start "$@" ;;
    stop)    cmd_stop ;;
    restart) cmd_stop; shift; [ "${1:-}" = "--" ] && shift; cmd_start "$@" ;;
    status)  cmd_status ;;
    # ⚠️ Does NOT follow by default. It used to be `tail -f`, which blocks
    # forever -- fine interactively, a hang anywhere else. It cost a
    # scripted clean-room run ten minutes of wall clock. Ask for -f.
    log)     shift
             if [ "${1:-}" = "-f" ]; then tail -f "$LOGFILE"
             else tail -n "${1:-200}" "$LOGFILE"; fi ;;
    config)  cmd_hint ;;
    voices)    cmd_voices ;;
    delvoice)  shift; cmd_delvoice "$@" ;;
    *)       { echo "usage: $(basename "$0") --start | --stop | --restart | --status"
               echo "       $(basename "$0") --voices"
               echo "       $(basename "$0") --addvoice NAME /path/to/clip.mp3"
               echo "       $(basename "$0") --delvoice NAME"
               echo "       $(basename "$0") --defaultvoice NAME"
               echo "       $(basename "$0") --config        backend JSON for a client"
               echo "       $(basename "$0") log [N|-f]      last N lines (200), -f follows"
               echo
               echo "Bare subcommands (start, stop, ...) work too; --start also"
               echo "follows the log. status exits 3 when not running."; } >&2
             exit 2 ;;
esac
